# Google Calendar embed link with every calendar the wall shows (src=...&color=... per calendar).
# Use the public copies made by apps-script/wall-calendar-sync.gs, so no Google login is needed.
GCAL_EMBED_URL=

# Skedda public booking view
SKEDDA_URL=

# Where the saved layout is kept (a persistent volume in production)
DATA_DIR=./data

# Music: "local" (this server talks to Sonos, only on the office network), "helper"
# (the kiosk browser talks to the helper on the PC) or "off". Defaults: local in dev, helper in production.
MUSIC_SOURCE=
# The helper's address as the kiosk browser sees it
MUSIC_HELPER_URL=http://127.0.0.1:5005
# Speaker IPs to try before network discovery (optional, comma separated)
SONOS_HOSTS=
# Highest volume the wall will set on any speaker (0 to 100)
MUSIC_MAX_VOLUME=85
# Lower limits for particular speakers, by their Sonos name: "Name=60, Other name=50"
MUSIC_SPEAKER_LIMITS=
